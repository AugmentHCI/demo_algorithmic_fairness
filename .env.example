# Copy this file to `.env` for local development and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.
# All variables are server-side only: nothing here is ever sent to the browser.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Supabase → Project Settings → API Keys → Secret key (sb_secret_…)
# (the legacy `service_role` key works too). Never expose this key in client code.
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"

# Shared secret the physical vote buttons send as `Authorization: Bearer <token>`
# when they POST to /api/votes. Generate one with: openssl rand -hex 32
VOTE_INGEST_TOKEN="YOUR_LONG_RANDOM_TOKEN"

# Optional: the password a vote tablet (/tablet/<poll>) asks for once.
# Defaults to "fti-demo" when not set.
# TABLET_PASSWORD="fti-demo"

# Groups votes and rankings per event, so results from a test run or a previous
# workshop don't mix with today's. Change it before every event, e.g. "2026-10-02-gent".
EVENT_ID="default"
